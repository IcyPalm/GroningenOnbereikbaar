{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.Title }} — Nieuws</title>
  <link>{{ "nieuws/" | absURL }}</link>
  <atom:link href="{{ "feed.xml" | absURL }}" rel="self" type="application/rss+xml"/>
  <description>Altijd iets nieuws om over te klagen. Een parodie op groningenbereikbaar.nl.</description>
  <language>nl-nl</language>
  {{- range (where site.RegularPages "Section" "nieuws") }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <guid>{{ .Permalink }}</guid>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <description>{{ .Params.teaser }}</description>
  </item>
  {{- end }}
</channel>
</rss>
